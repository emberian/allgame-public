# A small sandbox image for run_sandbox: bash, Python, and common tools.
#   docker build -t resident-sandbox -f docker/Dockerfile.sandbox .
FROM python:3.13-slim
RUN apt-get update \
 && apt-get install -y --no-install-recommends bash curl git jq ca-certificates \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /workspace
